# Copy to .env (never commit .env)

# Tailscale auth key: admin console -> Settings -> Keys -> Generate auth key
# Only used on the first start; the node identity is then kept in the tailscale_state volume
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# Machine name in the tailnet, gives the URL https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=ereader

# Image tag to deploy: "latest" or a full commit SHA (rollback = set the previous SHA)
TAG=latest
