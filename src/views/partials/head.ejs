<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Ereader Library</title>
  <%# Kept deliberately old-school for the Kobo's outdated WebKit: no JS, no CSS variables, no flexbox %>
  <style>
    body { margin: 0; padding: 1em; font-family: Georgia, serif; font-size: 28px; line-height: 1.4; color: #000; background: #fff; }
    h1 { font-size: 1.4em; margin: 0 0 0.6em; }
    label { display: block; margin-bottom: 0.3em; }
    input { font-size: 1.2em; width: 8em; padding: 0.2em; border: 3px solid #000; text-transform: uppercase; letter-spacing: 0.15em; }
    button, .button { display: inline-block; font-size: 1em; padding: 0.4em 1em; margin-top: 0.6em; border: 3px solid #000; background: #000; color: #fff; text-decoration: none; }
    .error { border: 3px solid #000; padding: 0.4em; font-weight: bold; }
    .meta { color: #333; }
    a { color: #000; }
  </style>
</head>
